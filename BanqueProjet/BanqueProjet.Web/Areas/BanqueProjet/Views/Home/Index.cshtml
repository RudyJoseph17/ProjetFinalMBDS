<!-- Cartes de stats -->
<div class="row">
    <div class="col">
        <div class="card">Total Projets: @Model.Stats.TotalProjets</div>
    </div>
    <div class="col">
        <div class="card">Projets Validés: @Model.Stats.ProjetsValides</div>
    </div>
</div>

<!-- Graphique par ministère -->
@if (ministeresJson == "[]" || countsJson == "[]")
{
    <div class="alert alert-info">Aucune donnée disponible pour le graphique.</div>
}
else
{
    <canvas id="projetsMinistereChart"></canvas>
}

@section Scripts {
    <script src="~/vendor/chart.js/Chart.min.js"></script>
    <script>
        const ministeres = @Html.Raw(ministeresJson);
        const counts = @Html.Raw(countsJson);

        if (Array.isArray(ministeres) && Array.isArray(counts) && ministeres.length) {
            const ctx = document.getElementById('projetsMinistereChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ministeres,
                    datasets: [{
                        label: 'Nombre de projets',
                        data: counts,
                        backgroundColor: 'rgba(78, 115, 223, 0.85)',
                        borderColor: 'rgba(78, 115, 223, 1)',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'Nombre de projets' } },
                        x: { title: { display: true, text: 'Ministères' } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }
    </script>
}

@model SuiviEvaluation.Web.Models.AutorisationViewModel

@{
    ViewData["Title"] = "Créer autorisation";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <!-- Nom du projet + ID caché -->
    <div class="form-group">
        <label>Projet</label>
        <input type="hidden" asp-for="IdIdentificationProjet" />
        <input type="text" class="form-control" value="@Model.NomProjet" readonly />
    </div>

    <!-- Conteneur des autorisations -->
    <div id="autorisations-container">
        @for (int i = 0; i < (Model.AutorisationsActivite?.Count ?? 1); i++)
        {
            var autorisation = Model.AutorisationsActivite.ElementAtOrDefault(i);
            <div class="autorisation-item mb-2" data-idx="@i">
                <div class="form-row">
                    <div class="col-md-3">
                        <label>Activité</label>
                        <select name="AutorisationsActivite[@i].IdActivites" class="form-control">
                            <option value="">-- choisir --</option>
                            @foreach (var act in Model.Activites ?? Enumerable.Empty<SelectListItem>())
                            {
                                var selected = autorisation != null && autorisation.IdActivites.ToString() == act.Value;
                                <option value="@act.Value" selected="@(selected ? "selected" : null)">@act.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label>Début</label>
                        <input name="AutorisationsActivite[@i].ExerciceFiscalDebut" class="form-control"
                               value="@(autorisation?.ExerciceFiscalDebut?.ToString() ?? "")" />
                    </div>
                    <div class="col-md-2">
                        <label>Fin</label>
                        <input name="AutorisationsActivite[@i].ExerciceFiscalFin" class="form-control"
                               value="@(autorisation?.ExerciceFiscalFin?.ToString() ?? "")" />
                    </div>
                    <div class="col-md-3">
                        <label>Montant</label>
                        <input name="AutorisationsActivite[@i].MontantAutorisation" class="form-control"
                               value="@(autorisation?.MontantAutorisation?.ToString("0.##") ?? "")" />
                    </div>
                    <div class="col-md-2 align-self-end">
                        <button type="button" class="btn btn-danger remove-item">Supprimer</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Boutons -->
    <div class="mt-3">
        <button type="button" id="add-autorisation" class="btn btn-outline-primary btn-sm">Ajouter une autorisation</button>
        <button type="submit" class="btn btn-primary">Créer</button>
        <a asp-action="Index" class="btn btn-secondary">Retour</a>
    </div>
</form>

@section Scripts {
    <script>
        var activityOptionsHtml = `@Html.Raw(string.Join("", (Model.Activites ?? Enumerable.Empty<SelectListItem>()).Select(a => $"<option value='{a.Value}'>{System.Net.WebUtility.HtmlEncode(a.Text)}</option>")))`;

        var template = `
        <div class="autorisation-item mb-2" data-idx="__IDX__">
            <div class="form-row">
                <div class="col-md-3">
                    <label>Activité</label>
                    <select name="AutorisationsActivite[__IDX__].IdActivites" class="form-control">
                        <option value="">-- choisir --</option>
                        ${activityOptionsHtml}
                    </select>
                </div>
                <div class="col-md-2">
                    <label>Début</label>
                    <input name="AutorisationsActivite[__IDX__].ExerciceFiscalDebut" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label>Fin</label>
                    <input name="AutorisationsActivite[__IDX__].ExerciceFiscalFin" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label>Montant</label>
                    <input name="AutorisationsActivite[__IDX__].MontantAutorisation" class="form-control" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button type="button" class="btn btn-danger remove-item">Supprimer</button>
                </div>
            </div>
        </div>`;

        function reindex() {
            document.querySelectorAll('#autorisations-container .autorisation-item').forEach(function (el, idx) {
                el.setAttribute('data-idx', idx);
                el.querySelectorAll('input, select').forEach(function (inp) {
                    inp.name = inp.name.replace(/AutorisationsActivite\[\d+\]/, `AutorisationsActivite[${idx}]`);
                });
            });
        }

        document.getElementById('add-autorisation').addEventListener('click', function () {
            var idx = document.querySelectorAll('#autorisations-container .autorisation-item').length;
            document.getElementById('autorisations-container').insertAdjacentHTML('beforeend', template.replace(/__IDX__/g, idx));
        });

        document.addEventListener('click', function (e) {
            if (e.target.matches('.remove-item')) {
                e.target.closest('.autorisation-item').remove();
                reindex();
            }
        });
    </script>
}

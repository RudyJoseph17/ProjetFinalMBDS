@model SuiviEvaluation.Application.Dtos.AutorisationSurProjetDto
@{
    ViewData["Title"] = "Modifier une autorisation";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="IdActivites" type="hidden" />

    <div class="form-group">
        <label asp-for="IdIdentificationProjet"></label>
        <input asp-for="IdIdentificationProjet" class="form-control" readonly />
    </div>

    <div class="form-row">
        <div class="col">
            <label asp-for="ExerciceFiscalDebut"></label>
            <input asp-for="ExerciceFiscalDebut" class="form-control" />
            <span asp-validation-for="ExerciceFiscalDebut" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="ExerciceFiscalFin"></label>
            <input asp-for="ExerciceFiscalFin" class="form-control" />
            <span asp-validation-for="ExerciceFiscalFin" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row mt-2">
        <div class="col">
            <label asp-for="Article"></label>
            <input asp-for="Article" class="form-control" />
            <span asp-validation-for="Article" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Alinea"></label>
            <input asp-for="Alinea" class="form-control" />
            <span asp-validation-for="Alinea" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row mt-2">
        <div class="col">
            <label asp-for="MoisAutorisation"></label>
            <input asp-for="MoisAutorisation" class="form-control" />
            <span asp-validation-for="MoisAutorisation" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="MontantAutorisation"></label>
            <input asp-for="MontantAutorisation" class="form-control" />
            <span asp-validation-for="MontantAutorisation" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </div>
</form>

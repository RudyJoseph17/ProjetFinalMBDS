@model IEnumerable<SuiviEvaluation.Web.Models.ProjetListItemViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nom du projet</th>
            <th>Coût total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.NomProjet</td>
                    <td class="text-right">@string.Format("{0:N2}", item.TotalAutorisation)</td>
                    <td>
                        <div class="btn-group">
                            <a class="btn btn-primary"
                               asp-area="SuiviEvaluation"
                               asp-controller="AutorisationSurProjet"
                               asp-action="Create"
                               asp-route-projectId="@item.IdIdentificationProjet"
                               asp-route-nomProjet="@item.NomProjet">
                                Autorisation
                            </a>
                            <a class="btn btn-secondary"
                               asp-area="SuiviEvaluation"
                               asp-controller="AutorisationSurProjet"
                               asp-action="Index"
                               asp-route-nomProjet="@item.NomProjet">
                                Voir Autorisations
                            </a>
                        </div>
                    </td>
                </tr>
        }
    </tbody>
</table>

@model SuiviEvaluation.Application.Dtos.AutorisationSurProjetDto
@{
    ViewData["Title"] = "Supprimer autorisation";
}
<h1>@ViewData["Title"]</h1>

<h4>Voulez-vous vraiment supprimer cette autorisation ?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Projet</dt>
    <dd class="col-sm-9">@Model.IdIdentificationProjet</dd>

    <dt class="col-sm-3">Id Activité</dt>
    <dd class="col-sm-9">@Model.IdActivites</dd>

    <dt class="col-sm-3">Exercice début</dt>
    <dd class="col-sm-9">@Model.ExerciceFiscalDebut</dd>

    <dt class="col-sm-3">Exercice fin</dt>
    <dd class="col-sm-9">@Model.ExerciceFiscalFin</dd>

    <dt class="col-sm-3">Montant</dt>
    <dd class="col-sm-9">@Model.MontantAutorisation</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="IdActivites" type="hidden" />
    <button type="submit" class="btn btn-danger" onclick="return confirm('Confirmer la suppression ?')">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>

@model IEnumerable<SuiviEvaluation.Web.Models.ProjetListItemViewModel>
@{
    ViewData["Title"] = "Accueil";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Bienvenue sur le module de Suivi Evaluation</h1>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Projets enregistrés</h6>
                <a asp-area="SuiviEvaluation" asp-controller="Home" asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">Rafraîchir</a>
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-info">Aucun projet trouvé dans le système.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nom du projet</th>
                                    <th class="text-right">Total autorisations</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="clickable-row"
                                        data-href="@Url.Action(
                                              action: "DetailsForSuivi",
                                              controller: "IdentificationProjet",
                                              values: new { area = "BanqueProjet", id = item.IdIdentificationProjet })"
                                        style="cursor:pointer">
                                        <td>@item.NomProjet</td>
                                        <td class="text-right">@item.TotalAutorisation.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lorsque l'utilisateur clique sur une ligne, on navigue vers la vue Détails
        document.addEventListener('DOMContentLoaded', function () {
            var rows = document.querySelectorAll('tr.clickable-row');
            rows.forEach(function (row) {
                row.addEventListener('click', function () {
                    var url = this.getAttribute('data-href');
                    if (url) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}

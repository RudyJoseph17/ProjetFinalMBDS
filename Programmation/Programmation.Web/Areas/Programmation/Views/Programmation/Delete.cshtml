@model ProgrammationViewModel
@{
    ViewData["Title"] = "Delete Programmation";
}

<h1>Delete Confirmation</h1>

<div class="alert alert-warning">
    Are you sure you want to delete programming for project
    <strong>@Model.Programmation.IdIdentificationProjet</strong> ?
</div>

<dl class="row">
    <dt class="col-sm-2">Project Name</dt>
    <dd class="col-sm-10">@Model.Programmation.NomProjet</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Programmation.IdIdentificationProjet" method="post">
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
